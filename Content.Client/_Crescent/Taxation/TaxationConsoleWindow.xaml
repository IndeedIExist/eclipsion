<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="680 720"
                      MinSize="520 400">
    <BoxContainer Orientation="Vertical" Margin="10 6 10 10">
        <Label Name="TreasuryLabel" StyleClasses="LabelKeyText" />
        <Label Name="AccessLabel" Margin="0 2 0 6" />
        <BoxContainer Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 6">
            <Label Text="{Loc 'taxation-console-default-label'}" VerticalAlignment="Center" />
            <LineEdit Name="DefaultRateEdit" MinWidth="90" PlaceHolder="0" VerticalAlignment="Center" Margin="6 0 2 0" />
            <Label Text="%" VerticalAlignment="Center" Margin="0 0 6 0" />
            <Button Name="DefaultSetButton" Text="{Loc 'taxation-console-set'}" />
        </BoxContainer>
        <Label Text="{Loc 'taxation-console-goods-header'}" StyleClasses="LabelKeyText" Margin="0 4 0 4" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="GoodsContainer" Orientation="Vertical" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
